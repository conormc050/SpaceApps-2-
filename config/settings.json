  "baselines": {
    "calibration_days": 7,
    "spreads_for_amber": 2.0,
    "consecutive_days": 2,
    "rule": "amber when the change from the personal baseline exceeds max(spreads_for_amber x own day-to-day spread, the indicator's fixed minimum) for consecutive_days in a row",
    "baseline_set_in_flight": true,
    "preflight_value_is_reference_only": true
  },
  "status_levels": ["green", "amber", "red"],
  "alerts": {
    "resting_hr": {
      "lcd_label": "HEART",
      "data": "simulated sensor",
      "min_change": 10.0,
      "unit": "BPM",
      "direction": "above",
      "days": 2,
      "quick_help": "Sit 5 min, slow breathing, measure again",
      "contact_when": "Still high after re-measuring, or you feel unwell"
    },
    "skin_temp": {
      "lcd_label": "SKIN TEMP",
      "data": "simulated sensor",
      "min_change": 0.5,
      "unit": "C",
      "direction": "above",
      "current_h": 24,
      "baseline_h": 72,
      "sustain_h": 6,
      "quick_help": "Rest, check sensor fit and cabin temperature, measure again",
      "contact_when": "Rise continues next day"
    },
    "sleep": {
      "lcd_label": "SLEEP",
      "data": "simulated sensor",
      "min_change": 1.0,
      "unit": "h",
      "direction": "below",
      "days": 2,
      "red_after_nights": 3,
      "quick_help": "Dim lights and cut noise an hour before bed",
      "contact_when": "3 or more short nights"
    },
    "mood": {
      "lcd_label": "MOOD",
      "data": "self-report, non-clinical",
      "quick_help": "Short break, talk to a crewmate, answer again",
      "contact_when": "Low scores continue 3 more days"
    },
    "cabin_air": {
      "lcd_label": "CABIN AIR",
      "data": "simulated relative index",
      "direction": "above",
      "sustain_h": 1,
      "quick_help": "Check vents, tell the crew lead",
      "contact_when": "Does not clear"
    },
    "cabin_night": {
      "lcd_label": "NOISE/LIGHT",
      "data": "simulated sensor",
      "direction": "above",
      "quick_help": "Move, dim or use ear protection",
      "contact_when": "Sleep stays short"
    },
    "blood_sugar": {
      "lcd_label": "BLOOD SUGAR",
      "data": "simulated, planned sensor",
      "quick_help": "Log it, measure again, eat or drink per nutrition plan",
      "contact_when": "Still out of range after re-measuring"
    },
    "blood_pressure": {
      "lcd_label": "BLOOD PRESS",
      "data": "simulated, planned sensor",
      "min_change": 10.0,
      "unit": "mmHg",
      "direction": "above",
      "readings": 2,
      "same_body_position": true,
      "quick_help": "Rest 5 min, measure again in the same position",
      "contact_when": "Stays high"
    },
    "blood_counts": {
      "lcd_label": "BLOOD COUNT",
      "data": "simulated, exposure indicator only, not a dose",
      "direction": "below",
      "checkups": 2,
      "min_drop_fraction": 0.15,
      "requires_both": ["wbc", "platelets"],
      "quick_help": "Nothing to self-treat",
      "contact_when": "Straight away; many possible causes; not a dose"
    }
  },
  "mood": {
    "scale_min": 1,
    "scale_max": 5,
    "low_score": 2,
    "low_days": 3,
    "drop_in_a_day": 2,
    "mismatch_days": 3,
    "red_after_more_days": 3,
    "send_to_earth_only_when_abnormal": true,
    "astronaut_sees_flag_first": true,
    "answer_style_weights": {"balanced": 1.0, "tends_to_say_fine": 0.6},
    "follow_up_question": "Your sleep and heart data look different from your check-in. Is there anything you want to add?",
    "questionnaire": {
      "purpose": "Estimates answer style only. It adjusts how much the mood self-report is weighted. It never labels mood and is not clinical.",
      "answer_scale": "1 strongly disagree to 5 strongly agree",
      "items": [
        {"text": "When someone asks how I am, I usually say fine without thinking.", "reverse": false},
        {"text": "I mention it early when something feels off.", "reverse": true},
        {"text": "I would rather finish the task than report a small problem.", "reverse": false},
        {"text": "I find it easy to put how I feel on a number scale.", "reverse": true},
        {"text": "I tend to pick the middle answer on surveys.", "reverse": false},
        {"text": "I play down discomfort so the crew does not worry.", "reverse": false},
        {"text": "My answers change when my day changes.", "reverse": true},
        {"text": "I answer check-ins quickly to get them done.", "reverse": false},
        {"text": "I tell a crewmate when I have slept badly.", "reverse": true},
        {"text": "I think small complaints are not worth logging.", "reverse": false}
      ],
      "says_fine_threshold": 3.5
    }
  },
