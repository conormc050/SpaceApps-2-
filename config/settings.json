  "serial": {
    "baud": 9600,
    "line_end": "\n",
    "line_max_bytes": 40,
    "glyph_char_base": 128,
    "host_to_device": {
      "L": "L<row digit><text padded to cols>  set one row; bytes 128-135 print custom characters 0-7",
      "G": "G<slot digit><16 hex digits>  define a custom character, 2 hex digits per row, 8 rows, low 5 bits used",
      "C": "C  clear the screen",
      "S": "S<G|A|R|O>  status light green, amber, red or off",
      "B": "B<milliseconds>  buzzer beep"
    },
    "device_to_host": {
      "READY": "READY <cols> <rows>  sent once after reset",
      "T": "T<tag id>  a tag was tapped; the host hashes it and never stores it",
      "K": "K<1-4>  a button was pressed",
      "V": "V<name>=<number>  an optional real sensor reading"
    }
  },
  "hardware": {
    "board": "Arduino Uno",
